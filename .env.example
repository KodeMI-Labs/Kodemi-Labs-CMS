# AWS DynamoDB Configuration
# Copy this to .env and fill in actual values (don't commit .env to git!)

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name_here

# Spring Boot Configuration
SERVER_PORT=8087
SPRING_APPLICATION_NAME=CMS

# DynamoDB Configuration
DYNAMODB_USE_LOCAL=false
DYNAMODB_ENDPOINT=http://localhost:8000

# Microservice Configuration
COURSE_MS_URL=http://localhost:8088

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Agent Configuration
AGENT_AUTHTOKEN=your_agent_token_here

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_FILE_NAME=logs/cms.log
